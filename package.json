{
  "name": "meguiars",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @meguiars/web",
    "dev:mobile": "npm run start -w @meguiars/mobile",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:db": "bash scripts/test-db.sh",
    "build:web": "npm run build -w @meguiars/web"
  },
  "engines": {
    "node": ">=22"
  }
}
