# Supabase (Project Settings → API). Usa la llave pública; nunca la service_role en el cliente.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL pública de la app, para el enlace de recuperación de contraseña
# (p. ej. https://meguiars-web.vercel.app). Si falta, se usa el origen de la petición.
NEXT_PUBLIC_SITE_URL=
# Ambiente: local | preview | production. En Vercel no hace falta: se toma de VERCEL_ENV.
# El build de preview y production falla si apunta a un Supabase local.
NEXT_PUBLIC_APP_ENV=
