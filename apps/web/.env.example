# Supabase (Project Settings → API). Usa la llave pública; nunca la service_role en el cliente.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL pública de la app, para el enlace de recuperación de contraseña
# (p. ej. https://meguiars-web.vercel.app). Si falta, se usa el origen de la petición.
NEXT_PUBLIC_SITE_URL=
# Ambiente: local | preview | production. En Vercel no hace falta: se toma de VERCEL_ENV.
# El build de preview y production falla si apunta a un Supabase local.
NEXT_PUBLIC_APP_ENV=
# SÓLO SERVIDOR (Vercel → Environment Variables, nunca NEXT_PUBLIC_). La llave de servicio la
# usan la evaluación diaria de alertas (/api/cron/alertas) y Usuarios (crear cuentas y cambiar
# contraseñas, tras validar al admin con su sesión). CRON_SECRET es el secreto que Vercel Cron
# envía como "Authorization: Bearer ...". Sin ellas el cron responde 401/503 y Usuarios no da altas.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
# CR2 fase 2 — Bandeja con las API oficiales de Meta. SÓLO SERVIDOR (nunca NEXT_PUBLIC_, nunca en
# la base ni en la app móvil). Sin ellas, Integraciones muestra «Pendiente de configurar» y la
# Bandeja no responde. Guía completa en docs/modules/bandeja.md.
# App Secret de la app de Meta: verifica la firma X-Hub-Signature-256 de cada webhook.
META_APP_SECRET=
# Texto que eliges y capturas también en la app de Meta al suscribir el webhook (/api/webhooks/meta).
META_WEBHOOK_VERIFY_TOKEN=
# Token de usuario del sistema con whatsapp_business_messaging (WhatsApp Cloud API).
WHATSAPP_ACCESS_TOKEN=
# Opcional: id de la cuenta de WhatsApp Business (WABA) para sincronizar plantillas aprobadas (fuera de 24 h).
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Token de la página con pages_messaging (Messenger).
MESSENGER_PAGE_ACCESS_TOKEN=
# Token de la cuenta profesional de Instagram con instagram_business_manage_messages.
INSTAGRAM_ACCESS_TOKEN=
# Opcional: versión de la Graph API (por omisión v26.0).
META_GRAPH_VERSION=
