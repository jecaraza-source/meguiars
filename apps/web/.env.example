# Supabase (Project Settings → API). Usa la llave pública; nunca la service_role en el cliente.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL pública de la app, para el enlace de recuperación de contraseña
# (p. ej. https://meguiars-web.vercel.app). Si falta, se usa el origen de la petición.
NEXT_PUBLIC_SITE_URL=
# Ambiente: local | preview | production. En Vercel no hace falta: se toma de VERCEL_ENV.
# El build de preview y production falla si apunta a un Supabase local.
NEXT_PUBLIC_APP_ENV=
# SÓLO SERVIDOR (Vercel → Environment Variables, nunca NEXT_PUBLIC_). La llave de servicio la
# usan la evaluación diaria de alertas (/api/cron/alertas) y Usuarios (crear cuentas y cambiar
# contraseñas, tras validar al admin con su sesión). CRON_SECRET es el secreto que Vercel Cron
# envía como "Authorization: Bearer ...". Sin ellas el cron responde 401/503 y Usuarios no da altas.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
