# Supabase (Project Settings → API). Usa la llave pública; nunca la service_role en el cliente.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# El enlace de recuperación vuelve a meguiars://auth/confirm (scheme de app.json).
# Agrégalo en Supabase → Authentication → URL Configuration → Redirect URLs.
# Ambiente: local | preview | production. En builds de EAS lo fija el perfil de eas.json.
EXPO_PUBLIC_APP_ENV=
